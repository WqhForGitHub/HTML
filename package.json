{
  "name": "html5-demos",
  "version": "1.0.0",
  "private": true,
  "description": "HTML5 Demo 合集 - ESLint + Prettier",
  "scripts": {
    "format": "prettier --write \"**/*.html\"",
    "format:check": "prettier --check \"**/*.html\"",
    "lint": "eslint --fix \"**/*.html\"",
    "lint:check": "eslint \"**/*.html\""
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-html": "^8.1.0",
    "prettier": "^3.3.0"
  }
}
